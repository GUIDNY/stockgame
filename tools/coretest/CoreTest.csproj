<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity-independent track core and checks every layout + the lap tracker. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/Scripts/Track/Vec2.cs" />
    <Compile Include="../../Assets/Scripts/Track/TrackSpline.cs" />
    <Compile Include="../../Assets/Scripts/Track/TrackLayouts.cs" />
    <Compile Include="../../Assets/Scripts/Track/LapTracker.cs" />
    <Compile Include="../../football/Assets/Scripts/Core/PitchGeometry.cs" />
    <Compile Include="../../football/Assets/Scripts/Core/Formation.cs" />
  </ItemGroup>
</Project>
